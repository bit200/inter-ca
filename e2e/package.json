{
  "name": "inter-ca-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "E2E тесты inter-ca (клиент) и сквозной поток через админку itk-platform. Запускаются вручную, не в CI. См. ../E2E_TEST_PLAN.md и README.md",
  "scripts": {
    "test": "playwright test",
    "test:manual": "E2E_MANUAL=1 playwright test",
    "test:ui": "E2E_MANUAL=1 playwright test --ui",
    "test:headed": "E2E_MANUAL=1 playwright test --headed",
    "report": "playwright show-report",
    "install-browsers": "playwright install chromium",
    "test:unit": "node --test helpers/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "dotenv": "^16.6.1"
  }
}
