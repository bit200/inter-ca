# Адрес, под которым сервис виден снаружи — он же issuer в токенах
PORT=7545
SSO_ISSUER=http://localhost:7545

# docker compose: на каком адресе хоста висит проброшенный PORT.
# 127.0.0.1 — сервис смотрит наружу через nginx с TLS (issuer в OIDC обязан быть https),
# 0.0.0.0 — если фронта перед сервисом нет.
SSO_BIND_ADDR=127.0.0.1

# Своя база под clients/tokens/sessions (без неё — хранилище в памяти).
# mongo — имя сервиса из docker-compose.yml; вне docker: mongodb://127.0.0.1:27017
SSO_DB_DRIVER=mongo
SSO_MONGO_URL=mongodb://mongo:27017
SSO_MONGO_DB=itk_sso

# Ключ подписи RS256 (PEM). Без него ключ генерируется на старте — только для стенда.
# В деплое файл лежит на хосте в ./keys и монтируется в контейнер; deploy.sh заведёт его сам.
SSO_JWT_PRIVATE_KEY_FILE=./keys/sso-private.pem
SSO_JWT_KID=itk-sso-1

# Проверка логина/пароля на itk-portal
ITK_PORTAL_URL=http://localhost:5553
ITK_PORTAL_VERIFY_PATH=/internal/verify-credentials
# Секрет общий с порталом: ту же строку кладут в .env портала
# (itk-platform-en/interviews/api) под именем ITK_SSO_INTERNAL_TOKEN и перезапускают его.
# Пока её там нет, портал отвечает на verify-credentials 503 «ITK_SSO_INTERNAL_TOKEN
# не настроен» — пароль не проверяется, и повтор входа даёт то же самое.
ITK_PORTAL_INTERNAL_TOKEN=

# Audience access token'ов и доступные scope ресурс-сервера
SSO_DEFAULT_RESOURCE=https://api.itk.academy
# Все API, на которые выписываются токены; карточка системы в /admin выбирает из них
SSO_RESOURCES=https://api.itk.academy
SSO_RESOURCE_SCOPES=mesh:read,mesh:write,evaluate:run,profile:read

# Короткий access token: логаут = отзыв refresh (#1947)
SSO_TTL_ACCESS=900
SSO_TTL_REFRESH=1209600

SSO_COOKIE_KEYS=change-me

# Пароль от админки реестра (/admin). Без него сервис придумает случайный
# и напечатает его в консоль при старте — открытой админка не бывает.
SSO_ADMIN_PASSWORD=
# Секрет подписи куки входа; по умолчанию выводится из пароля.
SSO_ADMIN_SECRET=

# Демо-«внешняя система» на /demo: кнопка «Войти через ITK» для локальной проверки
# Authorization Code + PKCE. По умолчанию включена везде, кроме NODE_ENV=production;
# SSO_DEMO=0 выключает её принудительно, SSO_DEMO=1 — включает.
SSO_DEMO=
SSO_DEMO_CLIENT_ID=itk-demo
SSO_DEMO_REDIRECT_URI=http://localhost:7545/demo/callback
